{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 600,
  "height": 500,
  "projection": {"type": "mercator"},
  "layer": [
    {
      "data": {
        "url": "AUS.topojson",
        "format": {"type": "topojson", "feature": "AUSADM1gbOpen"}
      },
      "mark": {"type": "geoshape", "fill": "lightgray", "stroke": "white"}
    },
    {
      "data": {
        "url": "disastereventextract.csv"
      },
      "mark": {"type": "circle", "tooltip": {"content": "data"}},
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "size": {
        "condition": {
        "test": "datum.regions === 'Multiple'",
        "value": 100
        },"value": 30
},
        "color": {
          "field": "disasterType",
          "type": "nominal",
          "scale": {
            "domain": ["Bushfire",
                      "Cyclone",
                      "Drought",
                      "Flood",
                      "Hail",
                      "Heatwave",
                      "Landslide",
                      "Severe Storm",
                      "Tornado"
                      ],

        "range": [
          "#FBB741",
          "#A3C6D4",
          "#BAA897",
          "#ff3366",
          "#B0C4DE",
          "#FF7A00",
          "#8B4513",
          "#447B8C",
          "#5D5B60"
        ]

        },
        "legend":null
      }
    }
  }
  ]
}