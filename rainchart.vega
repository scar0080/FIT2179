
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 920,
  "height": 250,
  "data": {
    "url": "rainfalldata.csv",
    "format": {"type": "csv"}
  },
  "title": "Annual rainfall anomaly 1910-2025 (compared to 1961–1990 average)",
  "params": [
    {
      "name": "hover",
      "select": {"type": "point", "encodings": ["x"], "on": "mouseover", "clear": "mouseout"}
    }
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "axis": {"labelAngle": 0, "labelExpr": "datum.value % 10 === 0 ? datum.value : ''"},
      "title":null
    },
    "y": {"aggregate": "count", "type": "quantitative", "axis": null}
  },
  "layer": [
    {
      "mark": {"type": "rect"},
      "encoding": {
        "color": {
          "field": "rain fall",
          "type": "quantitative",
          "scale": {
            "domain": [-200, 300],
            "range":[
              "#2B0B3A",
              "#48145F",
              "#5F276F",
              "#7A3F86",
              "#9762A0",
              "#B48CC0",
              "#D0B7DD",
              "#FFFFFF",
              "#D9E9DF",
              "#B6D8C8",
              "#8FC7AF",
              "#66B58F",
              "#40986F",
              "#196F53",
              "#073E2B"
            ],
      "domainMid": 0
          },
          "legend": {"title": "(mm)", "orient": "right", "format": "+.1f"}
        },
        "tooltip": [
          {"field": "year", "type": "ordinal"},
          {"field": "rain fall", "type": "quantitative", "format": "+.2f"}
        ],
        "opacity": {"condition": {"param": "hover", "value": 1}, "value": 0.85}
      }
    }
  ],
  "config": {
    "view": {"stroke": "transparent"},
    "axis": {"domain": false, "ticks": false, "labelColor": "#808080"}
  }
}


