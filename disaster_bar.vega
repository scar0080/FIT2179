{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "height":500,
  "width":300,
  "data": {
    "url": "disastercount.csv"
  },
      "mark": {
        "type": "bar",
        "tooltip": true
      },
       "encoding": {
        "y": {
        "field": "Disaster Type",
        "type": "nominal",
        "sort": "-x",
        "axis": {
          "title": null,
          "labelFontSize": 14
        }
        },

        "x": {
        "field": "Count",
        "type": "quantitative",
        "title": "Count of Disaster",
        "axis": {
          "grid": false,
          "domain": false,
          "ticks": false
        }
        },

"color": {
      "field": "Disaster Type",
      "type": "nominal",
      "legend": null,

      "scale": {
        "domain": [
          "Bushfire",
          "Cyclone",
          "Drought",
          "Flood",
          "Hail",
          "Heatwave",
          "Landslide",
          "Severe Storm",
          "Tornado"
        ],

        "range": [
          "#FBB741",
          "#A3C6D4",
          "#BAA897",
          "#ff3366",
          "#B0C4DE",
          "#FF7A00",
          "#8B4513",
          "#447B8C",
          "#5D5B60"
        ]
      }
    }
  },
"config": {
  "style": {
    "cell": {
      "stroke": "transparent"
    }
  }
}}
